# Données sources, entrepôt et exports : régénérables, jamais versionnés
data/
# Les dossiers warehouse/ et exports/ sont versionnés vides (.gitkeep) : DuckDB ne crée pas
# le dossier parent d'un fichier qu'il écrit (base de données, export Parquet).
warehouse/*
!warehouse/.gitkeep
exports/*
!exports/.gitkeep
*.duckdb
*.duckdb.wal
# Fichiers de débordement des sessions DuckDB en mémoire
.tmp/

# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Power BI : cache local et paramètres utilisateur du format PBIP
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf

# Environnement et éditeurs
.env
.vscode/
.idea/
Thumbs.db
.DS_Store
